# ---------------------------------------------------------------------------
# Database (local Postgres for dev; Neon Postgres URL for production)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:mohit123@localhost:5432/booking_platform?schema=public"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Auth / JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Redis (sessions / rate limiting / caching)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Stayly <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Storage (Cloudinary)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---------------------------------------------------------------------------
# Maps
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ---------------------------------------------------------------------------
# Production safety and booking rules (all optional)
# ---------------------------------------------------------------------------
# Number of reverse proxies in front of the app (Vercel/nginx/Cloudflare = 1). Needed for per-IP rate limits;
# 0 (default) means no forwarding header is trusted.
TRUSTED_PROXY_HOPS="0"
# Razorpay dashboard > Settings > Webhooks: events payment.captured + order.paid -> /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""
# Secret for POST/GET /api/cron/expire-bookings (send as "Authorization: Bearer <secret>")
CRON_SECRET=""
# Without a payment provider, bookings are REFUSED in production. Set to "true" only for a public demo
# deployment where free auto-confirmed bookings are intended.
ALLOW_DEMO_PAYMENTS="false"
# Minutes an unpaid booking holds its room (5-240, default 30)
BOOKING_HOLD_MINUTES="30"
# Cancelling at least this many hours before check-in refunds in full; later = no refund (default 48)
FREE_CANCELLATION_HOURS="48"
